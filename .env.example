# Supabase Configuration
# Replace these with your actual Supabase project settings found at:
# https://supabase.com/dashboard/project/<your-project-id>/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Optional: Dedicated staging/local E2E test credentials (Do NOT use production credentials)
TEST_USER_EMAIL=testuser@example.com
TEST_USER_PASSWORD=your-test-password
PLAYWRIGHT_TEST_BASE_URL=http://localhost:5173
